@DomainCopilot.Api_HostAddress = http://localhost:5121
@AdjusterApiKey = SET_YOUR_ADJUSTER_KEY_HERE
@ReviewerApiKey = SET_YOUR_REVIEWER_KEY_HERE
@claimId = REPLACE_WITH_CREATED_CLAIM_ID
@streamClaimId = REPLACE_WITH_ANOTHER_CREATED_CLAIM_ID
@reviewQueueItemId = REPLACE_WITH_QUEUE_ITEM_ID
@runId = REPLACE_WITH_RUN_ID

### Public health check
GET {{DomainCopilot.Api_HostAddress}}/health
Accept: application/json

### Receive a synthetic claim (Adjuster key)
POST {{DomainCopilot.Api_HostAddress}}/claims
X-API-Key: {{AdjusterApiKey}}
Content-Type: application/json

{
  "claimNumber": "CLM-DEMO-HTTP-001",
  "policyNumber": "POL-DEMO-001",
  "coverageCode": "WATER",
  "lossDate": "2025-06-15",
  "claimedAmount": 42000,
  "currency": "EGP",
  "description": "Synthetic water damage claim"
}

### Adjudicate the created claim (Adjuster key)
POST {{DomainCopilot.Api_HostAddress}}/claims/{{claimId}}/adjudicate
X-API-Key: {{AdjusterApiKey}}
X-Correlation-ID: 00000000-0000-0000-0000-000000000001
Accept: application/json

### Stream a different claim (run `curl.exe -N` for live SSE output)
POST {{DomainCopilot.Api_HostAddress}}/claims/{{streamClaimId}}/adjudicate/stream
X-API-Key: {{AdjusterApiKey}}
Accept: text/event-stream

### List the human review queue (Reviewer key)
GET {{DomainCopilot.Api_HostAddress}}/review-queue
X-API-Key: {{ReviewerApiKey}}
Accept: application/json

### Assign a queue item (Adjuster key)
PUT {{DomainCopilot.Api_HostAddress}}/review-queue/{{reviewQueueItemId}}/assignment
X-API-Key: {{AdjusterApiKey}}
Content-Type: application/json

{
  "reviewerId": "reviewer-asmaa"
}

### Start review after assignment (Reviewer key)
POST {{DomainCopilot.Api_HostAddress}}/review-queue/{{reviewQueueItemId}}/start
X-API-Key: {{ReviewerApiKey}}

### Approve the assigned item (Reviewer identity comes from the configured key)
POST {{DomainCopilot.Api_HostAddress}}/review-queue/{{reviewQueueItemId}}/decision
X-API-Key: {{ReviewerApiKey}}
Content-Type: application/json

{
  "action": "Approve",
  "editedDecision": null,
  "comment": "Reviewed the policy and claim evidence."
}

### Inspect an adjudication run (Reviewer key)
GET {{DomainCopilot.Api_HostAddress}}/agent-runs/{{runId}}
X-API-Key: {{ReviewerApiKey}}
Accept: application/json
